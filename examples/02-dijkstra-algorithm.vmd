# Dijkstra's Algorithm: Shortest Path Analysis

$METRICS$S
Time Complexity: O((V + E) log V) | Space: O(V) | Target Graph: Directed Non-Negative Weighted | Optimality: Greedy Choice
$METRICS$E

$CALLOUT$S?type=insight&title=Core+Principle
Dijkstra's algorithm finds the shortest path from a single source vertex to all other vertices in a weighted graph with **non-negative edge weights**. It maintains a tentative distance array and greedily selects the unvisited vertex with minimal tentative distance.
$CALLOUT$E

---

## Interactive Shortest Path Simulation

$CANVAS$S?engine=canvas2d&height=340&title=Graph+Visualization+Canvas
<!DOCTYPE html>
<html>
<head>
<style>
  body { margin: 0; background: #0f172a; color: #f8fafc; font-family: ui-sans-serif, system-ui; }
  #canvas { display: block; width: 100%; height: 260px; background: #0f172a; border-radius: 8px; }
  .controls { padding: 10px; display: flex; gap: 10px; align-items: center; justify-content: center; }
  button { background: #3b82f6; color: white; border: none; padding: 6px 14px; border-radius: 6px; cursor: pointer; font-weight: 500; font-size: 13px; }
  button:hover { background: #2563eb; }
  .status { font-size: 13px; color: #94a3b8; }
</style>
</head>
<body>
  <canvas id="canvas" width="600" height="260"></canvas>
  <div class="controls">
    <button id="stepBtn">Next Step</button>
    <button id="resetBtn">Reset</button>
    <span class="status" id="statusLabel">Step 0: Ready</span>
  </div>
  <script>
    const cv = document.getElementById('canvas');
    const ctx = cv.getContext('2d');
    const statusLabel = document.getElementById('statusLabel');

    const nodes = [
      { id: 'A', x: 80, y: 130, dist: 0, visited: false },
      { id: 'B', x: 220, y: 60, dist: Infinity, visited: false },
      { id: 'C', x: 220, y: 200, dist: Infinity, visited: false },
      { id: 'D', x: 380, y: 60, dist: Infinity, visited: false },
      { id: 'E', x: 380, y: 200, dist: Infinity, visited: false },
      { id: 'Z', x: 520, y: 130, dist: Infinity, visited: false }
    ];

    const edges = [
      { u: 'A', v: 'B', w: 4 },
      { u: 'A', v: 'C', w: 2 },
      { u: 'B', v: 'D', w: 5 },
      { u: 'C', v: 'E', w: 3 },
      { u: 'C', v: 'B', w: 1 },
      { u: 'D', v: 'Z', w: 2 },
      { u: 'E', v: 'Z', w: 7 }
    ];

    let currentStep = 0;
    const steps = [
      { msg: 'Init: Source A (dist=0). All other nodes dist=∞.', activeNode: 'A', activeEdge: null },
      { msg: 'Inspect neighbors of A: B (weight 4), C (weight 2). C is smaller.', activeNode: 'A', activeEdge: {u:'A',v:'C'} },
      { msg: 'Visit C (dist=2). Relax edge C->B (dist=2+1=3 < 4), C->E (dist=2+3=5).', activeNode: 'C', activeEdge: {u:'C',v:'B'} },
      { msg: 'Visit B (dist=3). Relax edge B->D (dist=3+5=8).', activeNode: 'B', activeEdge: {u:'B',v:'D'} },
      { msg: 'Visit E (dist=5). Relax edge E->Z (dist=5+7=12).', activeNode: 'E', activeEdge: {u:'E',v:'Z'} },
      { msg: 'Visit D (dist=8). Relax edge D->Z (dist=8+2=10 < 12). Path to Z found: 10!', activeNode: 'Z', activeEdge: {u:'D',v:'Z'} }
    ];

    function draw() {
      ctx.clearRect(0, 0, cv.width, cv.height);

      // Draw edges
      edges.forEach(e => {
        const u = nodes.find(n => n.id === e.u);
        const v = nodes.find(n => n.id === e.v);
        const isHighlighted = steps[currentStep] && steps[currentStep].activeEdge && 
          steps[currentStep].activeEdge.u === e.u && steps[currentStep].activeEdge.v === e.v;

        ctx.beginPath();
        ctx.moveTo(u.x, u.y);
        ctx.lineTo(v.x, v.y);
        ctx.strokeStyle = isHighlighted ? '#f59e0b' : '#334155';
        ctx.lineWidth = isHighlighted ? 3 : 1.5;
        ctx.stroke();

        // Edge label
        const mx = (u.x + v.x) / 2;
        const my = (u.y + v.y) / 2 - 6;
        ctx.fillStyle = isHighlighted ? '#fbbf24' : '#64748b';
        ctx.font = '11px sans-serif';
        ctx.fillText(e.w.toString(), mx, my);
      });

      // Draw nodes
      nodes.forEach(n => {
        const isActive = steps[currentStep] && steps[currentStep].activeNode === n.id;
        ctx.beginPath();
        ctx.arc(n.x, n.y, 18, 0, Math.PI * 2);
        ctx.fillStyle = isActive ? '#3b82f6' : '#1e293b';
        ctx.fill();
        ctx.strokeStyle = isActive ? '#60a5fa' : '#475569';
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.fillStyle = '#f8fafc';
        ctx.font = 'bold 12px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(n.id, n.x, n.y);
      });
    }

    document.getElementById('stepBtn').onclick = () => {
      if (currentStep < steps.length - 1) currentStep++;
      statusLabel.textContent = steps[currentStep].msg;
      draw();
    };

    document.getElementById('resetBtn').onclick = () => {
      currentStep = 0;
      statusLabel.textContent = steps[0].msg;
      draw();
    };

    statusLabel.textContent = steps[0].msg;
    draw();
  </script>
</body>
</html>
$CANVAS$E

