## Clean TypeScript Implementation

$SNIPPET$S?lang=typescript&title=dijkstra.ts
interface Edge {
  to: string;
  weight: number;
}

type Graph = Map<string, Edge[]>;

export function dijkstra(graph: Graph, start: string): Map<string, number> {
  const distances = new Map<string, number>();
  const pq: Array<[number, string]> = [[0, start]];

  for (const node of graph.keys()) {
    distances.set(node, Infinity);
  }
  distances.set(start, 0);

  while (pq.length > 0) {
    pq.sort((a, b) => a[0] - b[0]); // Min-heap simulated
    const [dist, u] = pq.shift()!;

    if (dist > (distances.get(u) ?? Infinity)) continue;

    for (const edge of graph.get(u) || []) {
      const newDist = dist + edge.weight;
      if (newDist < (distances.get(edge.to) ?? Infinity)) {
        distances.set(edge.to, newDist);
        pq.push([newDist, edge.to]);
      }
    }
  }

  return distances;
}
$SNIPPET$E

