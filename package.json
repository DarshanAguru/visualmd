{
  "name": "visualmd",
  "version": "1.0.2600000",
  "type": "module",
  "description": "VisualMD: Token-efficient interactive visual markdown workspace for AI-era engineers",
  "main": "packages/server/dist/index.js",
  "types": "packages/server/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/server/dist/index.d.ts",
      "import": "./packages/server/dist/index.js",
      "default": "./packages/server/dist/index.js"
    },
    "./compiler": {
      "types": "./packages/compiler/dist/index.d.ts",
      "import": "./packages/compiler/dist/index.js",
      "default": "./packages/compiler/dist/index.js"
    },
    "./canvas": {
      "types": "./packages/web/dist/canvas/index.d.ts",
      "import": "./packages/web/dist/canvas/index.js",
      "default": "./packages/web/dist/canvas/index.js"
    },
    "./react": {
      "types": "./packages/web/dist/canvas/index.d.ts",
      "import": "./packages/web/dist/canvas/index.js",
      "default": "./packages/web/dist/canvas/index.js"
    },
    "./canvas.css": "./packages/web/dist/canvas/canvas.css",
    "./styles.css": "./packages/web/dist/canvas/canvas.css",
    "./server": {
      "types": "./packages/server/dist/index.d.ts",
      "import": "./packages/server/dist/index.js",
      "default": "./packages/server/dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "browser": {
    "./packages/server/dist/index.js": "./packages/compiler/dist/index.js"
  },
  "bin": {
    "visualmd": "./packages/server/bin/visualmd.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:compiler": "npm run build --workspace=@visualmd/compiler",
    "build:server": "npm run build --workspace=@visualmd/server",
    "build:web": "npm run build --workspace=@visualmd/web",
    "build": "npm run build:compiler && npm run build:web && npm run build:server",
    "prepare": "npm run build",
    "start": "node --no-warnings packages/server/dist/cli.js",
    "start:local": "node --no-warnings packages/server/dist/cli.js",
    "dev": "node scripts/dev.mjs",
    "pretest": "npm run build:compiler && npm run build:server",
    "test": "npm run test --workspace=@visualmd/compiler && npm run test --workspace=@visualmd/server",
    "install:cli": "npm link",
    "bump": "node scripts/bump-version.mjs",
    "dev:web": "npm run dev --workspace=@visualmd/web",
    "dev:server": "npm run dev --workspace=@visualmd/server"
  },
  "files": [
    "packages/compiler/dist",
    "packages/compiler/package.json",
    "packages/server/dist",
    "packages/server/bin",
    "packages/server/package.json",
    "packages/web/dist",
    "examples",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "marked": "^15.0.7"
  },
  "keywords": [
    "visualmd",
    "markdown",
    "ai",
    "interactive",
    "documentation",
    "developer-tools",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarshanAguru/visualmd.git"
  },
  "bugs": {
    "url": "https://github.com/DarshanAguru/visualmd/issues"
  },
  "author": "Darshan Aguru <https://thisdarshiii.in>",
  "contributors": [
    "Darshan Aguru <https://thisdarshiii.in>",
    "Antigravity (Google DeepMind)"
  ],
  "homepage": "https://thisdarshiii.in/visualmd",
  "license": "MIT"
}
